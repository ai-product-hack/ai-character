# Диалог. Нужен ключ того провайдера, что выбран в app/config.json -> dialogue.
DEEPSEEK_API_KEY=

# Генератор сценария из текста. Он же нужен, если диалог переключён на
# anthropic (app/config.json -> dialogue.provider).
# Без него сервер работает, а генерация отдаёт шаблон по типу тренировки.
ANTHROPIC_API_KEY=

# Нужен только для варианта ElevenLabs. Без него Silero (ru_roman) работает.
ELEVENLABS_API_KEY=
