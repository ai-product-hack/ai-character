{
  "id": "s5_knowledge_check",
  "title": "Проверка знаний: регламент работы с персональными данными",
  "type": "knowledge",
  "agent_persona": "Методист-экзаменатор. Задаёт вопросы по регламенту, не подсказывает, фиксирует неполные ответы.",
  "steps": [
    {"n": 1, "goal": "база", "agent": "Что относится к персональным данным в нашем регламенте?", "expect": "перечисляет категории"},
    {"n": 2, "goal": "уточнение", "agent": "Вы назвали не всё. Что ещё?", "expect": "дополняет, не спорит", "trigger": "ответ неполный"},
    {"n": 3, "goal": "процедура", "agent": "Клиент просит удалить свои данные. Ваши действия по шагам?", "expect": "последовательность шагов и срок"},
    {"n": 4, "goal": "срок", "agent": "В какой срок вы обязаны ответить?", "expect": "конкретный срок"},
    {"n": 5, "goal": "кейс", "agent": "Коллега просит скинуть выгрузку клиентов в мессенджер. Что делаете?", "expect": "отказ и эскалация"},
    {"n": 6, "goal": "граница", "agent": "А если это ваш руководитель?", "expect": "позиция не меняется"},
    {"n": 7, "goal": "инцидент", "agent": "Вы случайно отправили файл не тому адресату. Первое действие?", "expect": "немедленная эскалация, не сокрытие"}
  ],
  "criteria": [
    {"key": "completeness", "title": "Полнота знания регламента", "scale": "1-5", "anchor_1": "путается в базовых определениях", "anchor_5": "полно и точно"},
    {"key": "procedure", "title": "Знание процедуры", "scale": "1-5", "anchor_1": "не знает шагов", "anchor_5": "шаги и сроки без подсказки"},
    {"key": "integrity", "title": "Устойчивость к давлению", "scale": "1-5", "anchor_1": "нарушает регламент по просьбе руководителя", "anchor_5": "держит позицию и эскалирует"}
  ]
}
